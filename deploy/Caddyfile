remoto.appelsoft.com.br {
	encode gzip

	# Registro dos downloads (métrica, sem exibir no painel). Entram no arquivo as rotas
	# /download (link público, checagens do atualizador e atualização da Equipe) e o
	# download pelo painel; o resto do painel e da API não é registrado (log_skip abaixo).
	# Fica em ./caddy-data/downloads.log na VPS. Contagem: deploy/contar-downloads.py.
	log {
		output file /data/downloads.log {
			roll_size 20MiB
			roll_keep 1000
			roll_keep_for 87600h
		}
		format json
	}

	# Link público só da versão do cliente (para mandar aos clientes).
	# A versão da equipe NÃO tem rota aqui: só sai pelo painel, com login.
	handle /download/cliente {
		root * /srv/downloads
		rewrite * /cliente.exe
		header Content-Disposition "attachment; filename=\"SuporteAppelsoft.exe\""
		file_server
	}

	# Versão publicada do cliente, lida pelo atualizador automático
	# (C:\ProgramData\SuporteAppelsoft\atualizar-cliente.ps1 nas máquinas).
	# Formato: {"versao": "1.5.3.1", "sha256": "<64 hex>", "url": "https://remoto.appelsoft.com.br/download/cliente"}
	handle /download/versao.json {
		root * /srv/downloads
		rewrite * /versao.json
		header Content-Type "application/json; charset=utf-8"
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}

	# Cliente para Windows 32 bits (interface antiga): link público e canal próprio de atualização.
	handle /download/cliente-x86 {
		root * /srv/downloads
		rewrite * /cliente-x86.exe
		header Content-Disposition "attachment; filename=\"SuporteAppelsoft-32bits.exe\""
		file_server
	}
	handle /download/versao-x86.json {
		root * /srv/downloads
		rewrite * /versao-x86.json
		header Content-Type "application/json; charset=utf-8"
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}

	# Atualização automática da Equipe. O caminho tem uma chave (secret ATUALIZADOR_CHAVE do
	# GitHub) que vai embutida no app da Equipe: quem não tem a Equipe não acha o arquivo.
	# Só esses dois nomes são servidos (sem listagem e sem os arquivos temporários).
	@atualizacao_equipe path_regexp ^/download/a/[A-Za-z0-9]{32,}/(versao\.json|equipe\.exe)$
	handle @atualizacao_equipe {
		root * /srv/downloads
		uri strip_prefix /download
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}

	@nao_download not path /api/admin/download/arquivo/*
	handle {
		log_skip @nao_download
		reverse_proxy 127.0.0.1:21114 {
			header_up X-Real-IP {remote_host}
		}
	}
}
